{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/article.html?id=:slug" },
    { "source": "/articles/:slug", "destination": "/article.html?id=:slug" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin.html", "permanent": false },
    { "source": "/contact", "destination": "/index.html#contact", "permanent": false }
  ],
  "404": "/404.html"
}
